# Frontend (Vite) environment — copy to web/.env
# Never put SUPABASE_SERVICE_ROLE_KEY here.

# Supabase Auth (client-safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-client-safe-anon-key

# API base URL.
# Leave empty in local Vite dev to use the proxy to http://localhost:3000.
# In production, set to the deployed API origin (e.g. https://api.example.com).
VITE_API_BASE_URL=

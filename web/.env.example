# Frontend (Vite) environment — copy to web/.env
# Never put SUPABASE_SERVICE_ROLE_KEY, NETLIFY_AUTH_TOKEN, or VERIFICATION_CODE_PEPPER here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-client-safe-anon-key

# Public tenant hostname base (must match Supabase TENANT_BASE_DOMAIN secret)
VITE_TENANT_BASE_DOMAIN=app.example.com

# Shown in Master handoff UI (CNAME target). Prefer real Netlify site hostname.
VITE_DEPLOYMENT_DNS_TARGET=your-site.netlify.app

# Localhost default tenant slug when hostname has no subdomain
VITE_TENANT_DEV_DEFAULT_SLUG=northline

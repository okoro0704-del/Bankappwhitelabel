# Frontend (Vite) environment — copy to web/.env
# Never put SUPABASE_SERVICE_ROLE_KEY, INITIAL_ADMIN_*, or VERIFICATION_CODE_* here.

# Supabase Auth (client-safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-client-safe-anon-key

# API base URL.
# Leave empty when using the Vite proxy (local) or Netlify API_ORIGIN proxy (production).
# For direct browser → API calls (no Netlify proxy), set e.g.:
# VITE_API_BASE_URL=https://api.example.com
# and set CORS_ORIGIN on the API to allow your Netlify / tenant origins.
VITE_API_BASE_URL=

# Netlify-only (set in Netlify UI, not required in local web/.env):
# API_ORIGIN=https://api.example.com
# → build writes /api/* proxy redirects so the SPA can keep a relative /api base URL.

# Frontend (Vite) environment — copy to web/.env
# Never put SUPABASE_SERVICE_ROLE_KEY, INITIAL_ADMIN_*, or VERIFICATION_CODE_* here.

# Supabase Auth (client-safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-client-safe-anon-key

# API base URL.
# Leave empty when using the Vite proxy (recommended for local development).
# For production static hosting that calls the API directly, set e.g.:
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

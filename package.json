{
  "name": "bank-app",
  "version": "1.0.0",
  "description": "Backend foundation for a fictional financial application using TypeScript and Supabase",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "dev": "node -r dotenv/config -r ts-node/register src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "node -r dotenv/config dist/src/index.js",
    "setup:initial-admin": "node -r dotenv/config -r ts-node/register src/scripts/setup-initial-admin.ts",
    "check:live-env": "npm run build && node -r dotenv/config dist/src/scripts/check-live-env.js",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "test:web": "npm --prefix web run test",
    "db:push": "supabase db push"
  },
  "keywords": [
    "typescript",
    "node",
    "supabase",
    "postgresql",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}

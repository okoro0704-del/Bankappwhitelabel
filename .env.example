# Environment configuration for the fictional bank app backend.
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Taxonomy:
#   PUBLIC CLIENT CONFIG — safe for browsers (also mirrored as VITE_* in web/.env)
#   SERVER-ONLY          — never expose via VITE_* or frontend bundles
#   BOOTSTRAP            — one-time setup commands only
#   DEVELOPMENT / TEST   — disabled or ignored in production

# =============================================================================
# PUBLIC CLIENT CONFIG (also set VITE_* mirrors in web/.env)
# =============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-client-safe-anon-key

# Frontend (Vite) uses a separate file: web/.env
# Copy web/.env.example → web/.env
#   VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY  (client-safe only)
#   VITE_API_BASE_URL=  (empty in local Vite so /api proxies to PORT)
# On Netlify, prefer API_ORIGIN=https://your-api-host (build-time proxy) over VITE_API_BASE_URL.
# Never put SUPABASE_SERVICE_ROLE_KEY or peppers in web/.env.

# =============================================================================
# SERVER-ONLY (never expose to browsers / VITE_*)
# =============================================================================
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
PORT=3000
# Bind address for containers (Railway/Docker). Leave as 0.0.0.0 in production.
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# Pepper for hashing fictional verification codes (recommended in all envs).
VERIFICATION_CODE_PEPPER=

# Comma-separated frontend origins allowed to call the API cross-origin.
# Do NOT use a bare *. Exact origins and single-label patterns are allowed:
#   CORS_ORIGIN=https://master.example.com,https://*.app.example.com
# Required when the static frontend and API are on different origins.
# Leave empty for local Vite proxy (proxy does not need CORS).
CORS_ORIGIN=

# Public base domain used to generate + resolve tenant hostnames:
#   {subdomain}.{TENANT_BASE_DOMAIN}
# Example: capitaltrust.app.example.com
# Resolution only trusts hosts under this base (attacker domains are rejected).
TENANT_BASE_DOMAIN=app.example.com

# CNAME target customers should point tenant hostnames at.
# Used by DNS verification and Master handoff instructions.
# For Netlify, typically: your-site.netlify.app
# Do NOT put service-role keys or secrets here.
DEPLOYMENT_DNS_TARGET=edgeserver.example.com

# Deployment provider: manual | netlify
# When unset, Netlify is selected automatically if NETLIFY_AUTH_TOKEN + NETLIFY_SITE_ID are set.
DEPLOYMENT_PROVIDER=manual

# =============================================================================
# Netlify (SERVER-ONLY — Phase 7 DNS automation)
# =============================================================================
# Personal access token / auth token for api.netlify.com
# Never put this in web/.env or VITE_* variables.
NETLIFY_AUTH_TOKEN=

# Shared white-label frontend site id (one site serves all tenants).
# Master clients cannot override this value.
NETLIFY_SITE_ID=

# Optional: Netlify DNS zone id for TENANT_BASE_DOMAIN.
# When empty, the API resolves a zone whose name matches the base domain.
NETLIFY_DNS_ZONE_ID=

# =============================================================================
# BOOTSTRAP (server-only setup command: npm run setup:initial-admin)
# =============================================================================
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_ACCOUNT_TYPE=escrow
INITIAL_ADMIN_ACCOUNT_NUMBER=

# =============================================================================
# DEVELOPMENT / TEST (ignored or rejected in production)
# =============================================================================
# Admin/dev plaintext code peek. Must be exactly "true" AND NODE_ENV must NOT
# be "production". Server refuses to start if enabled in production.
ALLOW_VERIFICATION_CODE_PEEK=false

# Default tenant slug when Host is localhost (development/test only).
# Never applied in production — unresolved hosts fail closed.
TENANT_DEV_DEFAULT_SLUG=northline

# When true AND NODE_ENV is not production, allow X-Tenant-Slug for local
# multi-tenant experiments. Server refuses to start if enabled in production.
ALLOW_DEV_TENANT_HEADER=false

# Optional live Supabase integration tests (not run in default CI):
# RUN_SUPABASE_INTEGRATION=1
# INTEGRATION_ADMIN_EMAIL=
# INTEGRATION_ADMIN_PASSWORD=

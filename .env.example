# Supabase project secrets (Dashboard → Edge Functions → Secrets). Never put these in VITE_*.
# SUPABASE_SERVICE_ROLE_KEY is provided automatically to Edge Functions.
# VERIFICATION_CODE_PEPPER=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# TENANT_BASE_DOMAIN=app.example.com
# DEPLOYMENT_DNS_TARGET=your-site.netlify.app
#
# Frontend (Netlify / web/.env) — client-safe only:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_TENANT_BASE_DOMAIN
#   VITE_DEPLOYMENT_DNS_TARGET
#
# Bootstrap Master Admin: insert into master_admins after creating the Auth user.
# See docs/QA.md

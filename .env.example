# Environment configuration for the fictional bank app backend.
# Copy to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Required (server cannot start / operate without these)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-client-safe-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
PORT=3000

# Comma-separated frontend origins allowed to call the API cross-origin.
# Required for production static hosting that calls the API directly.
# Do NOT use *. Leave empty for local Vite proxy (proxy does not need CORS).
# Example: CORS_ORIGIN=https://app.example.com
CORS_ORIGIN=

# Frontend (Vite) uses a separate file: web/.env
# Copy web/.env.example → web/.env
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY (client-safe only)
# VITE_API_BASE_URL=  (empty in local Vite so /api proxies to PORT)

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development

# -----------------------------------------------------------------------------
# Initial administrator bootstrap (server-only setup command)
# Used only by: npm run setup:initial-admin
# Never commit real passwords.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=Admin
INITIAL_ADMIN_LAST_NAME=User
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PHONE=
INITIAL_ADMIN_ACCOUNT_TYPE=escrow
INITIAL_ADMIN_ACCOUNT_NUMBER=

# -----------------------------------------------------------------------------
# Development / test only
# -----------------------------------------------------------------------------
# Pepper for hashing fictional verification codes (recommended in all envs).
VERIFICATION_CODE_PEPPER=

# Admin/dev plaintext code peek. Must be exactly "true" AND NODE_ENV must NOT
# be "production". Disabled by default. Never enable in production.
ALLOW_VERIFICATION_CODE_PEEK=false

# Optional live integration tests:
# RUN_SUPABASE_INTEGRATION=1
# INTEGRATION_ADMIN_EMAIL=
# INTEGRATION_ADMIN_PASSWORD=
